# =============================================================================
# Environment Variables for Clarification-Driven Text-to-SQL
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=text2sql
POSTGRES_USER=appuser
POSTGRES_PASSWORD=local_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Admin / Master Database URL (Full DDL/DML on app and uploaded_data schemas)
DATABASE_URL=postgresql+psycopg://appuser:local_dev_password@127.0.0.1:5432/text2sql

# Read-Only Database URL (Restricted SELECT only on uploaded_data schema)
READONLY_DATABASE_URL=postgresql+psycopg://readonly_user:readonly_dev_password@127.0.0.1:5432/text2sql

# LLM Configuration (External API key, server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration & CORS
FRONTEND_ORIGIN=http://localhost:5173

# Application Upload Limits
MAX_UPLOAD_MB=20
MAX_UPLOAD_ROWS=100000
MAX_UPLOAD_COLUMNS=250

# Query Execution Limits
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000

# Authentication & Session (Default user identity for local development)
DEFAULT_OWNER_ID=default_user

