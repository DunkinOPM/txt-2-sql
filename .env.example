# =============================================================================
# Clarification-Driven Conversational Text-to-SQL Environment Configuration
# Copy this file to .env and replace placeholder values with your actual secrets.
# NEVER commit .env to version control.
# =============================================================================

# Application Environment ('development' or 'production')
ENVIRONMENT=development

# Database Configuration (PostgreSQL 17)
POSTGRES_DB=text2sql
POSTGRES_USER=appuser
POSTGRES_PASSWORD=local_dev_password
READONLY_USER_PASSWORD=readonly_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Database Connection URLs (psycopg v3 driver)
# Master database connection for migrations and dynamic table provisioning
DATABASE_URL=postgresql+psycopg://appuser:local_dev_password@127.0.0.1:5432/text2sql
# Read-only database connection strictly for executing user-generated queries
READONLY_DATABASE_URL=postgresql+psycopg://readonly_user:readonly_dev_password@127.0.0.1:5432/text2sql

# Production Security & JWT Authentication
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gated Mock Authentication (MUST remain 'false' in production)
# When false, all requests must provide a verified JWT Bearer token.
ENABLE_MOCK_AUTH=false
DEFAULT_OWNER_ID=default_user

# Rate Limiting Guardrails (Requests per minute per client IP)
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# Google Gemini API Key (Required for LLM classification, clarification, and SQL generation)
GEMINI_API_KEY=placeholder_key

# Cross-Origin Resource Sharing (CORS)
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# File Upload and Guardrail Limits
MAX_UPLOAD_MB=20
MAX_UPLOAD_ROWS=100000
MAX_UPLOAD_COLUMNS=250

# Query Execution Safety Bounds
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000
